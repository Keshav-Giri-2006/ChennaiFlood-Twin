# ChennaiFlood-Twin backend configuration (copy to backend/.env and adjust).
# Only placeholders here - never commit real credentials.

APP_ENV=development
LOG_LEVEL=INFO

# Project data root (contains data_raw/, data_processed/, gis/, simulation/).
# Defaults to the repository root when unset.
# DATA_DIR=/srv/chennaiflood/data
# RAW_DATA_DIR=
# PROCESSED_DATA_DIR=
# GIS_DIR=
# MODEL_DIR=

# Runtime (written by the app). Defaults to backend/runtime/...
# RUNTIME_DIR=
# SIMULATION_WORKDIR=
# RESULTS_DIR=
# WEB_ASSETS_DIR=
# DATABASE_URL=sqlite:///path/to/chennaiflood.sqlite3
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/chennaiflood

# SWMM 5.2.4 command-line executable (runswmm). If unset, looked up on PATH.
# Windows example: SWMM_EXECUTABLE=C:\Program Files\EPA SWMM 5.2.4 (64-bit)\runswmm.exe
# Linux example:   SWMM_EXECUTABLE=/usr/local/bin/runswmm
SWMM_EXECUTABLE=
SWMM_TIMEOUT_SECONDS=900
SIMULATION_MAX_CONCURRENT=1

MODEL_VERSION=ward176-hydraulic-reconstructed-v1
PROCESSING_VERSION=swmm-results-v1
GIS_PROCESSING_VERSION=web-gis-v1
FLOOD_PROCESSING_VERSION=flood-processing-v1
BOTTLENECK_ANALYSIS_VERSION=bottleneck-analysis-v1
EXPOSURE_ANALYSIS_VERSION=exposure-analysis-v1
DECISION_SUPPORT_VERSION=decision-support-v1
BOTTLENECK_TIMELINE_VERSION=bottleneck-timeline-v1
SCENARIO_ANALYSIS_VERSION=scenario-analysis-v1

# Comma-separated list of allowed browser origins (no wildcard by default).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Future AWS settings (unused locally)
# AWS_REGION=
# S3_DATA_BUCKET=
# S3_RESULTS_BUCKET=
