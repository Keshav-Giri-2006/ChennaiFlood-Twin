# docker compose settings (copy to .env to override). Public-safe values only; never put credentials here.
FRONTEND_PORT=8080
BACKEND_PORT=8000
APP_ENV=container
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SIMULATION_MAX_CONCURRENT=1
SWMM_TIMEOUT_SECONDS=900
# DATABASE_URL=postgresql+psycopg://user:<password>@host:5432/chennaiflood
