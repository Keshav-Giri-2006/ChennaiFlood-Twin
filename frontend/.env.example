# Public, browser-safe configuration only. Never put secrets here.
# Base path of the ChennaiFlood-Twin API. In development Vite proxies /api to the backend.
VITE_API_BASE_URL=/api/v1
# Backend origin used by the Vite dev proxy (not shipped to the browser).
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
